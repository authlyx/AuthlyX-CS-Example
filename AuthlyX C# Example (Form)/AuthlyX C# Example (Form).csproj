<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <StartupObject Condition="'$(AuthlyXSmokeProbe)' == 'true'">ExampleEntryPoint</StartupObject><OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AuthlyX_CS_Example_Form</RootNamespace><GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources><AssemblyName>AuthlyX.Example.Forms</AssemblyName><DefineConstants>$(DefineConstants);AUTHLYX_FORMS_EXAMPLE</DefineConstants><LangVersion>latest</LangVersion><Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Condition="'$(AuthlyXSmokeProbe)' == 'true'" Include="../../tests/CSharp/ExampleEntryPoint.cs" Link="Testing/ExampleEntryPoint.cs" />
    <PackageReference Include="Guna.UI2.WinForms" Version="2.0.4.7" />
    <PackageReference Include="System.Resources.Extensions" Version="4.7.1" />
    <Reference Include="System.Net.Http" /><PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" /><PackageReference Include="Newtonsoft.Json" Version="13.0.4" /><PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
